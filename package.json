{
  "name": "teamytime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local workspace for collaborating GigaCode agents",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch scripts/dev.ts",
    "build": "node --import tsx scripts/build.ts",
    "prestart": "npm run build",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.0",
    "tsx": "4.22.1",
    "typescript": "5.9.3"
  }
}
